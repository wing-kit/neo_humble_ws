<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neobotix_e2e_test</name>
  <version>0.0.1</version>
  <description>End-to-end automated testing for Neobotix robot simulation</description>
  <maintainer email="test@example.com">Test User</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>launch_testing</depend>
  <depend>launch_testing_ros</depend>
  <depend>launch_ros</depend>
  <depend>neo_simulation2</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
